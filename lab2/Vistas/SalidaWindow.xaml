<Window x:Class="lab2.Vistas.SalidaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Operaciones - Registro de Salida" Height="620" Width="880"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushFondo}">
    <DockPanel>

        <Border DockPanel.Dock="Top" Background="{StaticResource BrushPrimario}" Height="50">
            <TextBlock Text="Registro de Salida" Style="{StaticResource TituloVentana}"/>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="{StaticResource BrushBorde}"
                BorderThickness="0,1,0,0" Padding="16,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Nuevo"   Style="{StaticResource BotonSecundario}" Click="btnNuevo_Click"/>
                <Button Content="Guardar" Style="{StaticResource BotonPrimario}"   Click="btnGuardar_Click"/>
                <Button Content="Cerrar"  Style="{StaticResource BotonSecundario}" Click="btnCerrar_Click"/>
            </StackPanel>
        </Border>

        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" CornerRadius="6" Padding="16"
                    BorderBrush="{StaticResource BrushBorde}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*" MinWidth="150"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*" MinWidth="150"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Ingreso pendiente:" Style="{StaticResource Etiqueta}"/>
                    <ComboBox  Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="4" x:Name="cboIngreso"
                               DisplayMemberPath="Descripcion" SelectionChanged="cboIngreso_SelectionChanged"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Placa:" Style="{StaticResource Etiqueta}"/>
                    <TextBox   Grid.Row="1" Grid.Column="1" x:Name="txtPlaca" IsReadOnly="True" Background="#ECEFF1"/>

                    <TextBlock Grid.Row="1" Grid.Column="3" Text="Conductor:" Style="{StaticResource Etiqueta}"/>
                    <TextBox   Grid.Row="1" Grid.Column="4" x:Name="txtConductor" IsReadOnly="True" Background="#ECEFF1"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Producto:" Style="{StaticResource Etiqueta}"/>
                    <TextBox   Grid.Row="2" Grid.Column="1" x:Name="txtProducto" IsReadOnly="True" Background="#ECEFF1"/>

                    <TextBlock Grid.Row="2" Grid.Column="3" Text="Peso de Ingreso (Kg):" Style="{StaticResource Etiqueta}"/>
                    <TextBox   Grid.Row="2" Grid.Column="4" x:Name="txtPesoIngreso" IsReadOnly="True" Background="#ECEFF1"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Fecha y Hora salida:" Style="{StaticResource Etiqueta}"/>
                    <Grid Grid.Row="3" Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="150"/>
                            <ColumnDefinition Width="90"/>
                        </Grid.ColumnDefinitions>
                        <DatePicker Grid.Column="0" x:Name="dtpFecha"/>
                        <TextBox Grid.Column="1" x:Name="txtHora" Margin="6,5,0,5" ToolTip="Formato HH:mm"/>
                    </Grid>

                    <TextBlock Grid.Row="3" Grid.Column="3" Text="Peso de Salida (Kg):" Style="{StaticResource Etiqueta}"/>
                    <TextBox   Grid.Row="3" Grid.Column="4" x:Name="txtPesoSalida" PreviewTextInput="SoloNumeros"
                               TextChanged="txtPesoSalida_TextChanged"/>
                </Grid>
            </Border>

            <DockPanel Grid.Row="1" Margin="0,16,0,0">
                <Border DockPanel.Dock="Top" Background="#E8F5E9" CornerRadius="4" Padding="12,8" Margin="0,0,0,10"
                        BorderBrush="#A5D6A7" BorderThickness="1">
                    <TextBlock x:Name="lblNeto" Text="Peso neto: 0.00 Kg" FontWeight="SemiBold" Foreground="#2E7D32"/>
                </Border>
                <TextBlock DockPanel.Dock="Top" Text="Salidas registradas" FontWeight="SemiBold"
                           Foreground="{StaticResource BrushTexto}" Margin="0,0,0,6"/>
                <DataGrid x:Name="dgSalidas">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="N."           Binding="{Binding Id}" Width="45"/>
                        <DataGridTextColumn Header="Placa"        Binding="{Binding Placa}" Width="85"/>
                        <DataGridTextColumn Header="Conductor"    Binding="{Binding NombreConductor}" Width="*" MinWidth="150"/>
                        <DataGridTextColumn Header="Producto"     Binding="{Binding Producto}" Width="120"/>
                        <DataGridTextColumn Header="Fecha y Hora" Binding="{Binding FechaHora, StringFormat=dd/MM/yyyy HH:mm}" Width="130"/>
                        <DataGridTextColumn Header="P. Ingreso"   Binding="{Binding PesoIngreso, StringFormat=N2}" Width="95"/>
                        <DataGridTextColumn Header="P. Salida"    Binding="{Binding PesoSalida, StringFormat=N2}" Width="95"/>
                        <DataGridTextColumn Header="P. Neto"      Binding="{Binding PesoNeto, StringFormat=N2}" Width="95"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
