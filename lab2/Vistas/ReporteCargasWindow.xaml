<Window x:Class="lab2.Vistas.ReporteCargasWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reportes - Listado de Cargas" Height="600" Width="1180"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushFondo}">
    <DockPanel>

        <Border DockPanel.Dock="Top" Background="{StaticResource BrushPrimario}" Height="50">
            <TextBlock Text="Listado de Cargas" Style="{StaticResource TituloVentana}"/>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="{StaticResource BrushBorde}"
                BorderThickness="0,1,0,0" Padding="16,10">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="lblRegistros" FontWeight="SemiBold" Foreground="{StaticResource BrushTexto}"/>
                    <TextBlock Text="   |   " Foreground="{StaticResource BrushBorde}"/>
                    <TextBlock x:Name="lblPesoTotal" FontWeight="SemiBold" Foreground="{StaticResource BrushTexto}"/>
                </StackPanel>
                <Button Content="Cerrar" HorizontalAlignment="Right"
                        Style="{StaticResource BotonPrimario}" Click="btnCerrar_Click"/>
            </Grid>
        </Border>

        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Expander Grid.Row="0" Header="Filtros de busqueda" IsExpanded="True"
                      Background="White" BorderBrush="{StaticResource BrushBorde}" BorderThickness="1"
                      Padding="12" Margin="0,0,0,12" FontWeight="SemiBold">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*" MinWidth="150"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*" MinWidth="150"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Fecha Inicio:" Style="{StaticResource Etiqueta}"/>
                    <DatePicker Grid.Row="0" Grid.Column="1" x:Name="dtpInicio"/>

                    <TextBlock Grid.Row="0" Grid.Column="3" Text="Fecha Fin:" Style="{StaticResource Etiqueta}"/>
                    <DatePicker Grid.Row="0" Grid.Column="4" x:Name="dtpFin"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Producto:" Style="{StaticResource Etiqueta}"/>
                    <ComboBox  Grid.Row="1" Grid.Column="1" x:Name="cboProducto" IsEditable="True"/>

                    <TextBlock Grid.Row="1" Grid.Column="3" Text="Estado:" Style="{StaticResource Etiqueta}"/>
                    <ComboBox  Grid.Row="1" Grid.Column="4" x:Name="cboEstado"/>

                    <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5" Orientation="Horizontal"
                                HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Content="Limpiar filtros" Style="{StaticResource BotonSecundario}" Click="btnLimpiar_Click"/>
                        <Button Content="Buscar"          Style="{StaticResource BotonPrimario}"   Click="btnBuscar_Click" IsDefault="True"/>
                    </StackPanel>
                </Grid>
            </Expander>

            <DataGrid Grid.Row="1" x:Name="dgCargas">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="N. Carga"   Binding="{Binding Numero}" Width="80"/>
                    <DataGridTextColumn Header="Fecha"      Binding="{Binding Fecha, StringFormat=dd/MM/yyyy HH:mm}" Width="130"/>
                    <DataGridTextColumn Header="Placa"      Binding="{Binding Placa}" Width="95"/>
                    <DataGridTextColumn Header="Conductor"  Binding="{Binding Conductor}" Width="*" MinWidth="150"/>
                    <DataGridTextColumn Header="Cliente"    Binding="{Binding Cliente}" Width="*" MinWidth="150"/>
                    <DataGridTextColumn Header="Producto"   Binding="{Binding Producto}" Width="120"/>
                    <DataGridTextColumn Header="P. Ingreso" Binding="{Binding PesoIngreso, StringFormat=N2}" Width="100"/>
                    <DataGridTextColumn Header="P. Salida"  Binding="{Binding PesoSalida, StringFormat=N2}" Width="100"/>
                    <DataGridTextColumn Header="P. Neto"    Binding="{Binding PesoNeto, StringFormat=N2}" Width="100"/>
                    <DataGridTextColumn Header="Estado"     Binding="{Binding Estado}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DockPanel>
</Window>
