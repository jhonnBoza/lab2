<Window x:Class="lab2.Vistas.MenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sistema de Balanza - Menu Principal" Height="560" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushFondo}">
    <DockPanel>

        <Menu DockPanel.Dock="Top" FontSize="13" Padding="4" Background="#E3F2FD">
            <MenuItem Header="_Operaciones">
                <MenuItem Header="_Ingresos" Click="MenuIngresos_Click"/>
                <MenuItem Header="_Salida"   Click="MenuSalida_Click"/>
            </MenuItem>
            <MenuItem Header="_Mantenimientos">
                <MenuItem Header="_Conductores"    Click="MenuConductores_Click"/>
                <MenuItem Header="_Transportistas" Click="MenuTransportistas_Click"/>
                <MenuItem Header="C_amiones"       Click="MenuCamiones_Click"/>
                <MenuItem Header="_Productos"      Click="MenuProductos_Click"/>
            </MenuItem>
            <MenuItem Header="_Reportes">
                <MenuItem Header="_Cargas"   Click="MenuRepCargas_Click"/>
                <MenuItem Header="_Ingresos" Click="MenuRepIngresos_Click"/>
                <MenuItem Header="_Salidas"  Click="MenuRepSalidas_Click"/>
            </MenuItem>
            <MenuItem Header="_Sesion">
                <MenuItem Header="Cerrar sesion" Click="MenuCerrarSesion_Click"/>
                <Separator/>
                <MenuItem Header="Salir" Click="MenuSalir_Click"/>
            </MenuItem>
        </Menu>

        <Border DockPanel.Dock="Top" Background="{StaticResource BrushOscuro}" Height="70">
            <Grid>
                <StackPanel VerticalAlignment="Center" Margin="16,0">
                    <TextBlock Text="SISTEMA DE BALANZA" Foreground="White" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text="Control de ingresos y salidas de vehiculos" Foreground="#BBDEFB" FontSize="12"/>
                </StackPanel>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Right" Margin="16,0">
                    <TextBlock x:Name="lblUsuario" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="lblFecha"   Foreground="#BBDEFB" FontSize="12" HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Border>

        <StatusBar DockPanel.Dock="Bottom" Background="#CFD8DC">
            <StatusBarItem Content="Lab 02 - Desarrollo de Aplicaciones Empresariales Avanzado"/>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="lblEstado" Text="Listo"/>
            </StatusBarItem>
        </StatusBar>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24">
                <TextBlock Text="Accesos directos" FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource BrushTexto}" Margin="0,0,0,12"/>
                <WrapPanel>
                    <Button Content="Registrar Ingreso"    Tag="ingreso"   Click="Acceso_Click" Style="{StaticResource BotonAcceso}"/>
                    <Button Content="Registrar Salida"     Tag="salida"    Click="Acceso_Click" Style="{StaticResource BotonAcceso}"/>
                    <Button Content="Conductores"          Tag="conductor" Click="Acceso_Click" Style="{StaticResource BotonAcceso}"/>
                    <Button Content="Lista de Conductores" Tag="lista"     Click="Acceso_Click" Style="{StaticResource BotonAcceso}"/>
                    <Button Content="Transportistas"       Tag="transp"    Click="Acceso_Click" Style="{StaticResource BotonAcceso}"/>
                    <Button Content="Camiones"             Tag="camion"    Click="Acceso_Click" Style="{StaticResource BotonAcceso}"/>
                    <Button Content="Productos"            Tag="producto"  Click="Acceso_Click" Style="{StaticResource BotonAcceso}"/>
                    <Button Content="Reporte de Ingresos"  Tag="reping"    Click="Acceso_Click" Style="{StaticResource BotonAcceso}"/>
                    <Button Content="Reporte de Salidas"   Tag="repsal"    Click="Acceso_Click" Style="{StaticResource BotonAcceso}"/>
                    <Button Content="Reporte de Cargas"    Tag="repcar"    Click="Acceso_Click" Style="{StaticResource BotonAcceso}"/>
                </WrapPanel>

                <TextBlock Text="Resumen" FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource BrushTexto}" Margin="0,24,0,12"/>
                <WrapPanel x:Name="pnlResumen"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
