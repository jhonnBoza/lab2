<Window x:Class="lab2.Vistas.ProductoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mantenimiento - Productos" Height="500" Width="740"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushFondo}">
    <DockPanel>

        <Border DockPanel.Dock="Top" Background="{StaticResource BrushPrimario}" Height="50">
            <TextBlock Text="Registro de Productos" Style="{StaticResource TituloVentana}"/>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="{StaticResource BrushBorde}"
                BorderThickness="0,1,0,0" Padding="16,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Nuevo"    Style="{StaticResource BotonSecundario}" Click="btnNuevo_Click"/>
                <Button Content="Guardar"  Style="{StaticResource BotonPrimario}"   Click="btnGuardar_Click"/>
                <Button Content="Eliminar" Style="{StaticResource BotonSecundario}" Click="btnEliminar_Click"/>
                <Button Content="Cerrar"   Style="{StaticResource BotonSecundario}" Click="btnCerrar_Click"/>
            </StackPanel>
        </Border>

        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" CornerRadius="6" Padding="16"
                    BorderBrush="{StaticResource BrushBorde}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*" MinWidth="150"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Nombre Producto:" Style="{StaticResource Etiqueta}"/>
                    <TextBox   Grid.Row="0" Grid.Column="1" x:Name="txtNombre"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Unidad de medida:" Style="{StaticResource Etiqueta}"/>
                    <ComboBox  Grid.Row="1" Grid.Column="1" x:Name="cboUnidad" IsEditable="True"/>
                </Grid>
            </Border>

            <DockPanel Grid.Row="1" Margin="0,16,0,0">
                <TextBlock DockPanel.Dock="Top" Text="Productos registrados" FontWeight="SemiBold"
                           Foreground="{StaticResource BrushTexto}" Margin="0,0,0,6"/>
                <DataGrid x:Name="dgProductos">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="N."      Binding="{Binding Id}" Width="50"/>
                        <DataGridTextColumn Header="Nombre"  Binding="{Binding Nombre}" Width="*" MinWidth="150"/>
                        <DataGridTextColumn Header="Unidad"  Binding="{Binding Unidad}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
