<Window x:Class="lab2.Vistas.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Balanza - Inicio de sesion" Height="420" Width="700"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{StaticResource BrushFondo}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270"/>
            <ColumnDefinition Width="*" MinWidth="150"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource BrushOscuro}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="SISTEMA DE" Foreground="#90CAF9" FontSize="14" HorizontalAlignment="Center"/>
                <TextBlock Text="BALANZA" Foreground="White" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Text="Control de Ingresos y Salidas" Foreground="#BBDEFB" FontSize="12"
                           HorizontalAlignment="Center" Margin="0,8,0,0"/>
                <Border Height="2" Width="120" Background="#42A5F5" Margin="0,20"/>
                <TextBlock Text="Lab 02 - WPF" Foreground="#90CAF9" FontSize="12" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="40,0">
            <TextBlock Text="Iniciar sesion" FontSize="22" FontWeight="SemiBold"
                       Foreground="{StaticResource BrushTexto}" Margin="0,0,0,4"/>
            <TextBlock Text="Ingrese sus credenciales para continuar" Foreground="#78909C" Margin="0,0,0,18"/>

            <TextBlock Text="Usuario" Style="{StaticResource Etiqueta}" HorizontalAlignment="Left"/>
            <TextBox x:Name="txtUsuario" TabIndex="0"/>

            <TextBlock Text="Contrasena" Style="{StaticResource Etiqueta}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
            <PasswordBox x:Name="txtPassword" TabIndex="1" KeyDown="txtPassword_KeyDown"/>

            <TextBlock x:Name="lblError" Foreground="#C62828" Margin="0,10,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Salir"    Style="{StaticResource BotonSecundario}" Click="btnSalir_Click" TabIndex="3"/>
                <Button Content="Ingresar" Style="{StaticResource BotonPrimario}"   Click="btnIngresar_Click" TabIndex="2" IsDefault="True"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
