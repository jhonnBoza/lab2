<Window x:Class="lab2.Vistas.IngresoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Operaciones - Registro de Ingresos" Height="640" Width="1010"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushFondo}">
    <DockPanel>

        <Border DockPanel.Dock="Top" Background="{StaticResource BrushPrimario}" Height="50">
            <TextBlock Text="Registro de Ingresos" Style="{StaticResource TituloVentana}"/>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="{StaticResource BrushBorde}"
                BorderThickness="0,1,0,0" Padding="16,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Nuevo"   Style="{StaticResource BotonSecundario}" Click="btnNuevo_Click"/>
                <Button Content="Guardar" Style="{StaticResource BotonPrimario}"   Click="btnGuardar_Click"/>
                <Button Content="Cerrar"  Style="{StaticResource BotonSecundario}" Click="btnCerrar_Click"/>
            </StackPanel>
        </Border>

        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" CornerRadius="6" Padding="16"
                    BorderBrush="{StaticResource BrushBorde}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*" MinWidth="150"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*" MinWidth="150"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Tipo Documento:" Style="{StaticResource Etiqueta}"/>
                    <ComboBox  Grid.Row="0" Grid.Column="1" x:Name="cboTipoDocumento"/>

                    <TextBlock Grid.Row="0" Grid.Column="3" Text="Numero Documento:" Style="{StaticResource Etiqueta}"/>
                    <TextBox   Grid.Row="0" Grid.Column="4" x:Name="txtNumeroDocumento"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Placa:" Style="{StaticResource Etiqueta}"/>
                    <ComboBox  Grid.Row="1" Grid.Column="1" x:Name="cboPlaca" IsEditable="True"/>

                    <TextBlock Grid.Row="1" Grid.Column="3" Text="Turno:" Style="{StaticResource Etiqueta}"/>
                    <ComboBox  Grid.Row="1" Grid.Column="4" x:Name="cboTurno"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Nombre Conductor:" Style="{StaticResource Etiqueta}"/>
                    <ComboBox  Grid.Row="2" Grid.Column="1" x:Name="cboConductor" IsEditable="True"
                               SelectionChanged="cboConductor_SelectionChanged"/>

                    <TextBlock Grid.Row="2" Grid.Column="3" Text="Nombre Cliente:" Style="{StaticResource Etiqueta}"/>
                    <TextBox   Grid.Row="2" Grid.Column="4" x:Name="txtCliente"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Fecha y Hora:" Style="{StaticResource Etiqueta}"/>
                    <Grid Grid.Row="3" Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="150"/>
                            <ColumnDefinition Width="90"/>
                        </Grid.ColumnDefinitions>
                        <DatePicker Grid.Column="0" x:Name="dtpFecha"/>
                        <TextBox Grid.Column="1" x:Name="txtHora" Margin="6,5,0,5" ToolTip="Formato HH:mm"/>
                    </Grid>

                    <TextBlock Grid.Row="3" Grid.Column="3" Text="Peso de Ingreso (Kg):" Style="{StaticResource Etiqueta}"/>
                    <TextBox   Grid.Row="3" Grid.Column="4" x:Name="txtPeso" PreviewTextInput="SoloNumeros"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Producto:" Style="{StaticResource Etiqueta}"/>
                    <ComboBox  Grid.Row="4" Grid.Column="1" x:Name="cboProducto"/>

                    <TextBlock Grid.Row="4" Grid.Column="3" Text="Transporte:" Style="{StaticResource Etiqueta}"/>
                    <TextBox   Grid.Row="4" Grid.Column="4" x:Name="txtTransporte" IsReadOnly="True" Background="#ECEFF1"/>
                </Grid>
            </Border>

            <DockPanel Grid.Row="1" Margin="0,16,0,0">
                <TextBlock DockPanel.Dock="Top" Text="Ingresos registrados" FontWeight="SemiBold"
                           Foreground="{StaticResource BrushTexto}" Margin="0,0,0,6"/>
                <DataGrid x:Name="dgIngresos">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="N."           Binding="{Binding Id}" Width="45"/>
                        <DataGridTextColumn Header="Tipo Doc."    Binding="{Binding TipoDocumento}" Width="120"/>
                        <DataGridTextColumn Header="Nro. Doc."    Binding="{Binding NumeroDocumento}" Width="110"/>
                        <DataGridTextColumn Header="Placa"        Binding="{Binding Placa}" Width="85"/>
                        <DataGridTextColumn Header="Turno"        Binding="{Binding Turno}" Width="80"/>
                        <DataGridTextColumn Header="Conductor"    Binding="{Binding NombreConductor}" Width="*" MinWidth="150"/>
                        <DataGridTextColumn Header="Cliente"      Binding="{Binding NombreCliente}" Width="*" MinWidth="150"/>
                        <DataGridTextColumn Header="Fecha y Hora" Binding="{Binding FechaHora, StringFormat='dd/MM/yyyy HH:mm'}" Width="130"/>
                        <DataGridTextColumn Header="Peso (Kg)"    Binding="{Binding PesoIngreso, StringFormat=N2}" Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
